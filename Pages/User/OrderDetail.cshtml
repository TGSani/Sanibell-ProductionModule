@page
@using Sanibell_ProductionModule.Models
@model OrderDetailModel
@{
    ViewData["Title"] = "Order Details ";
}

@section PageStyle {
    <link rel="stylesheet" href="~/css/userOrderDetail.css" />
}
<div class="body">
    <div class="content-wrapper">
        @foreach (var order in Model.OrderDetails)
        {
            <table class="data-container">
                <thead>
                    <tr>
                        <th>Order nummer</th>
                        <th>Recept Code</th>
                        <th>Omschrijving</th>
                        <th>aantal</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="number-align">@order.OrderNummer</td>
                        <td>@order.ReceptCode</td>
                        <td>@order.Omschrijving</td>
                        <td class="number-align">@order.Aantal</td>

                    </tr>
                </tbody>
            </table>
            <div class="hidden">
                    @foreach (var item in Model.OrderDetails)
                    {
                        <p>@order.Omschrijving</p>
                        <p>@order.OrderNummer</p>
                        <img src="data:image/png;base64,@item.BarcodeBase64" />
                    }
            </div>
            <table class="data-container">
                <thead>
                    <tr>
                        <th>Components</th>
                        <th>aantal</th>
                        <th>locatie code</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in order.Components)
                    {
                        <tr>
                            <td>@item.Naam</td>
                            <td>@item.Aantal</td>
                            <td>@item.LocatieCode</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="btn-group">
        <form method = "post" id = "activeStatusOrder">
            <button class="shadowbox" type="submit" form="activeStatusOrder" formaction="?handler=StartOrder">Start Order</button>
        </form>
        <button class="shadowbox">Print Etiket</button>
        <form method="post" id="processOrder">
            <button class="shadowbox"  type="submit" form="processOrder" formaction="?handler=CompleteOrder">Afronden Order</button>
        </form>
        
    </div>
</div>