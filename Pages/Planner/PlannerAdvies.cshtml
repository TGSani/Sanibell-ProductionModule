@page
@using Sanibell_ProductionModule.Models
@using System.Globalization
@model PlannerAdviesModel
@{
    ViewData["Title"] = "Planner Advies";
}
@section PageStyle {
    <link rel="stylesheet" href="~/css/PlannerAdvies.css" />
}

<form method="post" id="planningForm" class="form-wrapper">
    @Html.AntiForgeryToken()

    <div class="form-header">
        <input class="search-field" type="text" id="searchInput" placeholder="Zoek in alle kolommen" />
    </div>

    <table class="data-container">
        <thead>
            <tr>
                <th>Artikel Nummer</th>
                <th>Omschrijving</th>
                <th>maat</th>
                <th>kleur</th>
                <th>Huidige voorraad NL / PL</th>
                <th>Week @CultureInfo.CurrentCulture.Calendar.GetWeekOfYear(DateTime.Now.AddDays(7),
                                        CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday)</th>
                <th>Week @CultureInfo.CurrentCulture.Calendar.GetWeekOfYear(DateTime.Now.AddDays(14),
                                        CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday)</th>
                <th>Week @CultureInfo.CurrentCulture.Calendar.GetWeekOfYear(DateTime.Now.AddDays(21),
                                        CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday)</th>
                <th>Leverdatum</th>
                <th>Aantal</th>
                <th>Urgent</th>
                <th>Selectie</th>
            </tr>
        </thead>
        <tbody id="PlannerTableBody">
            @for (int i = 0; i < Model.Planners.Count; i++)
            {
                var p = Model.Planners[i];
                <tr>
                    <td>@p.ArticleNumber<input type="hidden" name="Planners[@i].ArticleNumber" value="@p.ArticleNumber" /></td>
                    <td>@p.ArticleDescription</td>
                    <td>@p.Size</td>
                    <td>@p.Color</td>
                    <td>@p.TotalCurrentStockNL / @p.TotalCurrentStockPL</td>
                    <td>@p.Recommended7Days</td>
                    <td>@p.Recommended14Days</td>
                    <td>@p.Recommended21Days</td>
                    <td>
                        <input type="date" name="Planners[@i].ReadyDate" value="@p.ReadyDate.ToString("yyyy-MM-dd")"
                            min="@p.ReadyDate.ToString("yyyy-MM-dd")" />
                    </td>
                    <td><input type="number" name="Planners[@i].Amount" value="@p.Amount" min="@(p.Recommended7Days)" /></td>
                    <td><input type="checkbox" class="urgency-item" name="Planners[@i].Urgency" value="true" @(p.Urgency ? "checked" : "") /></td>
                    <td><input type="checkbox" class="selection-item" name="Planners[@i].Selection" value="true" @(p.Selection ? "checked" : "") /></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="form-buttons">
        @if (TempData["Message"] != null)
        {
            var type = TempData["MessageType"]?.ToString() ?? "info";
            <div class="alert alert-@type">@TempData["Message"]</div>
        }
        <div id="loading" style="display:none;" class="alert alert-info">Orders worden verzonden...</div>
        <div id="validationErrors" style="display:none;" class="alert alert-error"></div>
        <button class="shadowbox" type="submit">Orders Aanmaken</button>
        <button class="shadowbox" type="button" id="toggleAll">Selecteer alles</button>
    </div>
</form>

@section Scripts {
    <script src="~/js/PlannerAdvies.js"></script>
}